# Canonical URL for metadata, sitemap, Open Graph, and email links.
# Optional on Vercel (falls back to the production deployment URL).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ---- "Book a call" modal ----
# Cal.com or Calendly link. The button is hidden until this is set.
NEXT_PUBLIC_BOOKING_URL=https://cal.com/your-name/30min

# ---- Contact form email: pick ONE provider ----

# Option A (recommended with a custom domain): Resend, https://resend.com
# Verify your domain in Resend (adds SPF/DKIM DNS records), then:
RESEND_API_KEY=
MAIL_FROM="Vikram Kumar <hello@your-domain.com>"

# Option B: SMTP via Nodemailer (e.g. Gmail + App Password,
# https://myaccount.google.com/apppasswords). Used only if RESEND_API_KEY is empty.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=

# Where new-message notifications are delivered (defaults to the profile email).
CONTACT_TO=you@gmail.com

# ---- Spam protection ----
# Cloudflare Turnstile (free): https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis (free tier) for a rate limit shared across serverless instances.
# Easiest: Vercel > Storage > Upstash for Redis, which sets these automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Messages allowed per IP per 10 minutes (default 5)
CONTACT_RATE_LIMIT=5
