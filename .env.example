# Canonical URL for metadata, sitemap, Open Graph, and email links.
# Optional on Vercel (falls back to the production deployment URL).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ---- Contact form (Nodemailer, server-only) ----
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# true for port 465, false for 587 (STARTTLS). Defaults from the port if unset.
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password

# Sender shown to recipients. Gmail only allows your own address (or a verified alias).
MAIL_FROM="Vikram Kumar <you@gmail.com>"
# Where new-message notifications are delivered.
CONTACT_TO=you@gmail.com
